// ── AI (asistente gerencial) ──────────────────────────────────────────
// Registro de cada consulta al asistente IA: auditoria, costo y trazabilidad.
// La tabla ya existe en produccion (schema ai) — este modelo la versiona en Prisma.
model AiQueryLog {
  id                Int      @id @default(autoincrement())
  requestId         String?  @unique @map("request_id")
  userId            Int?     @map("user_id")
  userEmail         String?  @map("user_email")
  userNombre        String?  @map("user_nombre")
  role              String?
  sucursalId        Int?     @map("sucursal_id")
  permisosExtraHash String?  @map("permisos_extra_hash")
  question          String
  questionHash      String?  @map("question_hash")
  normalizedQuery   String?  @map("normalized_query")
  requestedModules  Json?    @map("requested_modules")
  allowedModules    Json?    @map("allowed_modules")
  deniedModules     Json?    @map("denied_modules")
  scope             String   @default("operacional")
  usedTools         Json?    @map("used_tools")
  citations         Json?
  status            String   @default("ok")
  refusalReason     String?  @map("refusal_reason")
  answerPreview     String?  @map("answer_preview")
  model             String?
  tokenUsage        Json?    @map("token_usage")
  latencyMs         Int?     @map("latency_ms")
  error             String?
  ip                String?
  userAgent         String?  @map("user_agent")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("query_logs")
  @@schema("ai")
}

// Conversaciones persistentes del asistente: historial reabrible por usuario.
model AiConversacion {
  id        Int         @id @default(autoincrement())
  userId    Int         @map("user_id")
  titulo    String      @default("Nueva conversación")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  mensajes  AiMensaje[]

  @@index([userId, updatedAt])
  @@map("conversaciones")
  @@schema("ai")
}

model AiMensaje {
  id             Int            @id @default(autoincrement())
