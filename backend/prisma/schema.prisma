  id            Int        @id @default(autoincrement())
  trabajadorId  Int        @map("trabajador_id")
  anio          String
  mes           String
  dia           String
  tipoDiaId     Int?       @map("tipo_dia_id")
  jornadaId     Int        @map("jornada_id")
