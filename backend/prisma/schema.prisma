  @@schema("ventas")
}

// ── CAJA ─────────────────────────────────────────────────────────────

model Caja {
  id         Int     @id @default(autoincrement())
  nombre     String
  sucursalId Int?    @map("sucursal_id")
  activa     Boolean @default(true)
  turnos     Turno[]

  @@map("cajas")
  @@schema("caja")
}

model Turno {
  id             Int              @id @default(autoincrement())
  cajaId         Int              @map("caja_id")
  userId         Int              @map("user_id")
  cerradoPorId   Int?             @map("cerrado_por_id")
  estado         String           @default("abierto")
  apertura       DateTime         @default(now())
  cierre         DateTime?
  caja           Caja             @relation(fields: [cajaId], references: [id])
  movimientos    MovimientoCaja[]
  cierreSnapshot CierreCaja?

  @@map("turnos")
  @@schema("caja")
}

model MovimientoCaja {
  id              Int       @id @default(autoincrement())
  turnoId         Int?      @map("turno_id")
  tipo            String
  monto           Float
  medioPago       String    @map("medio_pago")
  cuotas          Int?
  referencia      String?
  ordenId         Int?      @map("orden_id")
  sucursalId      Int?      @map("sucursal_id")
  documento       String?
  nDoc            String?   @map("n_doc")
  tipoDocumento   String?   @map("tipo_documento")
  estadoDoc       String?   @map("estado_doc")
  estadoPagoDoc   String?   @map("estado_pago_doc")
  pagaCon         Float?    @map("paga_con")
  nMedioPago      String?   @map("n_medio_pago")
  origenMedioPago String?   @map("origen_medio_pago")
  numeroNCInterna String?   @map("numero_nc_interna")
  gastoTipoId     Int?      @map("gasto_tipo_id")
  origenTipo      String?   @map("origen_tipo")
  origenId        Int?      @map("origen_id")
  usuario         String?
  fecha           DateTime?
  eliminado       Boolean   @default(false)
  fecham          DateTime?
  userMod         String?   @map("user_mod")
  createdAt       DateTime  @default(now()) @map("created_at")
  turno           Turno?    @relation(fields: [turnoId], references: [id])
  orden           Orden?    @relation(fields: [ordenId], references: [id], onDelete: SetNull)
  gastoTipo       Gasto?    @relation(fields: [gastoTipoId], references: [id])

  @@index([turnoId])
  @@index([ordenId])
  @@index([sucursalId])
  @@index([gastoTipoId])
  @@index([origenTipo, origenId])
  @@index([fecha])
  @@map("movimientos_caja")
  @@schema("caja")
}

model CierreCaja {
  id                   Int      @id @default(autoincrement())
  turnoId              Int      @unique @map("turno_id")
  cerradoPorId         Int?     @map("cerrado_por_id")
  cerradoPorNombre     String?  @map("cerrado_por_nombre")
  efectivo             Float    @default(0)
  debito               Float    @default(0)
  credito              Float    @default(0)
  chequeDia            Float    @default(0) @map("cheque_dia")
  chequeFecha          Float    @default(0) @map("cheque_fecha")
  transferencia        Float    @default(0)
  webpay               Float    @default(0)
  transbank            Float    @default(0)
  comision             Float    @default(0)
  otros                Float    @default(0)
  total                Float    @default(0)
  efectivoContado      Float    @default(0) @map("efectivo_contado")
  debitoContado        Float    @default(0) @map("debito_contado")
  creditoContado       Float    @default(0) @map("credito_contado")
  chequeDiaContado     Float    @default(0) @map("cheque_dia_contado")
  chequeFechaContado   Float    @default(0) @map("cheque_fecha_contado")
  transferenciaContado Float    @default(0) @map("transferencia_contado")
  webpayContado        Float    @default(0) @map("webpay_contado")
  transbankContado     Float    @default(0) @map("transbank_contado")
  otrosContado         Float    @default(0) @map("otros_contado")
  totalContado         Float    @default(0) @map("total_contado")
  diferencia           Float    @default(0)
  obs                  String?
  createdAt            DateTime @default(now()) @map("created_at")
  turno                Turno    @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@map("cierres_caja")
  @@schema("caja")
}

model Gasto {
  id          Int              @id @default(autoincrement())
  nombre      String           @unique
  activo      Boolean          @default(true)
  movimientos MovimientoCaja[]

  @@map("gastos")
  @@schema("caja")
}

// ── TALLER ───────────────────────────────────────────────────────────

model Odt {
  id                     Int                @id @default(autoincrement())
  tipo                   String?
  clienteNombre          String?            @map("cliente_nombre")
  descripcion            String?
  obsGeneral             String?            @map("obs_general")
  plazo                  DateTime?
  fechaIngreso           DateTime?          @map("fecha_ingreso")
  fechaInicio            DateTime?          @map("fecha_inicio")
  fechaTermino           DateTime?          @map("fecha_termino")
  ordenId                Int?               @map("orden_id")
  centroCostoId          Int?               @map("centro_costo_id")
  sucursalId             Int?               @map("sucursal_id")
  legacyNInterno         Int?               @unique @map("legacy_n_interno")
  estado                 String             @default("Pendiente")
  prioridad              String             @default("normal")
  emergencia             Boolean            @default(false)
  vendedorId             Int?               @map("vendedor_id")
  operarioId             Int?               @map("operario_id")
  eliminado              Boolean            @default(false)
  createdAt              DateTime           @default(now()) @map("created_at")
  fechaEntregaCompromiso DateTime?          @map("fecha_entrega_compromiso")
  items                  OdtItem[]
  bitacora               BitacoraTaller[]
  evidencias             TallerEvidencia[]
  movimientosBodega      MovimientoBodega[]
  despachos              Despacho[]
  guiasDespacho          GuiaDespacho[]
  centroCosto            CentroCosto?       @relation(fields: [centroCostoId], references: [id], onDelete: Restrict)

  @@index([centroCostoId])
  @@index([createdAt])
  @@map("odts")
  @@schema("taller")
}

model CentroCosto {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  odts        Odt[]

  @@index([activo])
  @@map("centros_costo")
  @@schema("taller")
}

model BitacoraTaller {
  id             Int       @id @default(autoincrement())
  odtId          Int?      @map("odt_id")
  usuario        String
  usuarioReporta String?   @map("usuario_reporta")
  ipEquipo       String?   @map("ip_equipo")
  sucursalId     Int?      @map("sucursal_id")
  fecha          DateTime?
  texto          String
  createdAt      DateTime  @default(now()) @map("created_at")
  odt            Odt?      @relation(fields: [odtId], references: [id], onDelete: Cascade)

  @@map("bitacora_taller")
  @@schema("taller")
}

model CategoriaBodegaTaller {
  id            Int                        @id @default(autoincrement())
  nombre        String                     @unique
  activo        Boolean                    @default(true)
  subcategorias SubcategoriaBodegaTaller[]

  @@map("categorias_bodega_taller")
  @@schema("taller")
}

// G14: usuarios externos web tienda + banners promocionales
model UsuarioWeb {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  nombre       String
  rut          String?
  telefono     String?
  direccion    String?
  comuna       String?
  region       String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("usuarios_web")
  @@schema("catalogo")
}

model Banner {
  id        Int       @id @default(autoincrement())
  titulo    String
  subtitulo String?
  imagenUrl String?   @map("imagen_url")
  link      String?
  orden     Int       @default(0)
  activo    Boolean   @default(true)
  desde     DateTime?
  hasta     DateTime?
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("banners")
  @@schema("catalogo")
}

model SubcategoriaBodegaTaller {
  id          Int                   @id @default(autoincrement())
  nombre      String
  categoriaId Int                   @map("categoria_id")
  activo      Boolean               @default(true)
  categoria   CategoriaBodegaTaller @relation(fields: [categoriaId], references: [id])

  @@index([categoriaId])
  @@map("subcategorias_bodega_taller")
  @@schema("taller")
}

model BodegaTaller {
  id              Int                           @id @default(autoincrement())
  codigoInterno   String                        @unique @map("codigo_interno")
  codigoBarra     String?                       @map("codigo_barra")
  nombre          String
  detalle         String?
  unidadMedida    String?                       @map("unidad_medida")
  categoriaId     Int?                          @map("categoria_id")
  subcategoriaId  Int?                          @map("subcategoria_id")
  stockCritico    Float                         @default(0) @map("stock_critico")
  stock           Float                         @default(0)
  proveedorId     Int?                          @map("proveedor_id")
  sucursalId      Int?                          @map("sucursal_id")
  precio          Float                         @default(0)
  densidadKgM3    Float?                        @map("densidad_kg_m3")
  espesorMm       Float?                        @map("espesor_mm")
  formato         String?
  tallerId        Int?                          @map("taller_id")
  activo          Boolean                       @default(true)
  taller          Taller?                       @relation(fields: [tallerId], references: [id], onDelete: SetNull)
  movimientos     BodegaTallerMovimiento[]
  recetaLineas    RecetaMaterial[]
  precioHistorial BodegaTallerPrecioHistorial[]
  lotes           BodegaTallerLote[]

  @@index([tallerId])
  @@map("bodega_taller")
  @@schema("taller")
}

// Reglas configurables que convierten una transición excepcional en una tarea
// auditable. No bloquean por defecto: Gerencia decide esa política por regla.
model ExcepcionRegla {
  id                Int               @id @default(autoincrement())
  codigo            String            @unique
  nombre            String
  descripcion       String?
  estadoDestino     String?           @map("estado_destino")
  severidad         String            @default("alta")
  horasEscalamiento Int               @default(24) @map("horas_escalamiento")
  rolResponsable    String            @default("coordinador_comercial") @map("rol_responsable")
  rolEscalamiento   String            @default("admin") @map("rol_escalamiento")
  activo            Boolean           @default(true)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  alertas           ExcepcionAlerta[]

  @@index([activo, estadoDestino])
  @@map("excepcion_reglas")
  @@schema("ventas")
}

model ExcepcionAlerta {
  id              Int            @id @default(autoincrement())
  reglaId         Int            @map("regla_id")
  ordenId         Int?           @map("orden_id")
  estado          String         @default("ABIERTA")
  severidad       String
  rolResponsable  String         @map("rol_responsable")
  rolEscalamiento String         @map("rol_escalamiento")
  venceAt         DateTime       @map("vence_at")
  escaladaAt      DateTime?      @map("escalada_at")
  resueltaAt      DateTime?      @map("resuelta_at")
  resueltaPorId   Int?           @map("resuelta_por_id")
  evidencia       String?
  createdAt       DateTime       @default(now()) @map("created_at")
  regla           ExcepcionRegla @relation(fields: [reglaId], references: [id], onDelete: Restrict)
  orden           Orden?         @relation(fields: [ordenId], references: [id], onDelete: SetNull)

  @@index([estado, venceAt])
  @@index([ordenId, estado])
  @@map("excepcion_alertas")
  @@schema("ventas")
}

model BodegaTallerLote {
  id                 Int          @id @default(autoincrement())
  bodegaTallerId     Int          @map("bodega_taller_id")
  codigo             String
  cantidadInicial    Float        @map("cantidad_inicial")
  cantidadDisponible Float        @map("cantidad_disponible")
  estadoCalidad      String       @default("aprobado") @map("estado_calidad")
  observacion        String?
  recibidoAt         DateTime     @default(now()) @map("recibido_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  item               BodegaTaller @relation(fields: [bodegaTallerId], references: [id], onDelete: Restrict)

  @@unique([bodegaTallerId, codigo])
  @@index([bodegaTallerId, estadoCalidad])
  @@map("bodega_taller_lotes")
  @@schema("taller")
}

model BodegaTallerMovimiento {
  id              Int            @id @default(autoincrement())
  bodegaTallerId  Int            @map("bodega_taller_id")
  tipo            String
  cantidad        Float
  motivo          String?
  userId          Int?           @map("user_id")
  pagoProveedorId Int?           @map("pago_proveedor_id")
  origenTipo      String?        @map("origen_tipo")
  origenId        Int?           @map("origen_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  item            BodegaTaller   @relation(fields: [bodegaTallerId], references: [id], onDelete: Cascade)
  pagoProveedor   PagoProveedor? @relation(fields: [pagoProveedorId], references: [id], onDelete: SetNull)

  @@index([bodegaTallerId])
  @@index([pagoProveedorId])
  @@index([origenTipo, origenId])
  @@map("bodega_taller_movimientos")
  @@schema("taller")
}

model TallerMaterial {
  id            Int     @id @default(autoincrement())
  odtId         Int?    @map("odt_id")
  codigoInterno String? @map("codigo_interno")
  nombre        String?
  cantidad      Float
  unidad        String?
  taller        String?

  @@index([odtId])
  @@map("taller_materiales")
  @@schema("taller")
}

model TallerHistorialMaterial {
  id            Int      @id @default(autoincrement())
  odtId         Int?     @map("odt_id")
  codigoInterno String?  @map("codigo_interno")
  nombre        String?
  egreso        Float    @default(0)
  ingreso       Float    @default(0)
  unidad        String?
  usuario       String?
  fecha         DateTime
  taller        String?
  sucursalId    Int?     @map("sucursal_id")
  loteCodigo    String?  @map("lote_codigo")
  calidad       String?
  mermaCantidad Float    @default(0) @map("merma_cantidad")
  mermaMotivo   String?  @map("merma_motivo")

  @@index([odtId])
  @@map("taller_historial_materiales")
  @@schema("taller")
}

model Taller {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  // Quien aprueba la calidad de lo que sale de este taller. El control lo hace el
  // jefe del taller correspondiente, y hasta ahora no habia forma de saber quien es:
  // el rol `taller` gobierna todos los talleres por igual.
  jefeId Int? @map("jefe_id")
  jefe   User? @relation("TallerJefe", fields: [jefeId], references: [id], onDelete: SetNull)

  estados        OdtItemTaller[]
  productos      Producto[]       @relation("ProductoTaller")
  materiales     BodegaTaller[]
  tarifas        TarifaProceso[]
  recetas        ProductoReceta[]
  recetaProcesos RecetaProceso[]

  @@map("talleres")
  @@schema("taller")
}

model OdtItem {
  id            Int             @id @default(autoincrement())
  odtId         Int             @map("odt_id")
  productoId    Int             @map("producto_id")
  codigoInterno String?         @map("codigo_interno")
  nombre        String?
  obs           String?
  estado        String          @default("pendiente")
  cantidad      Int
  fechaListo    DateTime?       @map("fecha_listo")
  usuario       String?
  eliminado     Boolean         @default(false)
  odt           Odt             @relation(fields: [odtId], references: [id], onDelete: Cascade)
  talleres      OdtItemTaller[]

  @@index([odtId])
  @@map("odt_items")
  @@schema("taller")
}

model OdtItemTaller {
  id                    Int                 @id @default(autoincrement())
  odtItemId             Int                 @map("odt_item_id")
  tallerId              Int                 @map("taller_id")
  estado                String              @default("pendiente")
  obs                   String?
  fechaInicio           DateTime?           @map("fecha_inicio")
  fechaListo            DateTime?           @map("fecha_listo")
  usuario               String?
  usuarioListo          String?             @map("usuario_listo")
  operarioResponsableId Int?                @map("operario_responsable_id")
  odtItem               OdtItem             @relation(fields: [odtItemId], references: [id], onDelete: Cascade)
  taller                Taller              @relation(fields: [tallerId], references: [id])
  operarioResponsable   User?               @relation("OdtResponsable", fields: [operarioResponsableId], references: [id])
  avances               OdtAvance[]
  evidencias            TallerEvidencia[]
  recepciones           OdtEtapaRecepcion[]

  @@unique([odtItemId, tallerId])
  @@index([tallerId])
  @@map("odt_item_talleres")
  @@schema("taller")
}

model CrmAsignacionHistorial {
  id                 Int      @id @default(autoincrement())
  crmId              Int      @map("crm_id")
  vendedorId         Int?     @map("vendedor_id")
  vendedorAnteriorId Int?     @map("vendedor_anterior_id")
  origen             String
  motivo             String?
  asignadoPorId      Int?     @map("asignado_por_id")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([crmId, createdAt])
  @@index([vendedorId, createdAt])
  @@map("crm_asignaciones_historial")
  @@schema("ventas")
}

model NotaCreditoInterna {
  id              Int                      @id @default(autoincrement())
  ordenId         Int                      @map("orden_id")
  monto           Float
  motivo          String
  estado          String                   @default("activa")
  usuarioId       Int?                     @map("usuario_id")
  usuarioNombre   String?                  @map("usuario_nombre")
  anuladaAt       DateTime?                @map("anulada_at")
  anuladaPor      String?                  @map("anulada_por")
  motivoAnulacion String?                  @map("motivo_anulacion")
  createdAt       DateTime                 @default(now()) @map("created_at")
  orden           Orden                    @relation(fields: [ordenId], references: [id], onDelete: Restrict)
  items           NotaCreditoInternaItem[]

  @@index([ordenId, estado])
  @@map("notas_credito_internas")
  @@schema("ventas")
}

model NotaCreditoInternaItem {
  id               Int                @id @default(autoincrement())
  notaId           Int                @map("nota_id")
  ordenItemId      Int                @map("orden_item_id")
  productoId       Int                @map("producto_id")
  cantidad         Int
  precioUnitario   Float              @map("precio_unitario")
  monto            Float
  stockReintegrado Boolean            @default(false) @map("stock_reintegrado")
  nota             NotaCreditoInterna @relation(fields: [notaId], references: [id], onDelete: Cascade)
  producto         Producto           @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@index([notaId])
  @@index([productoId])
  @@map("notas_credito_interna_items")
  @@schema("ventas")
}

// Lo que la etapa siguiente declara al recibir el trabajo de la anterior. Es la
// inspeccion de calidad: quien recibe es el primer interesado en que venga bien, y
// ya esta ahi. Se registra por cantidad y no por si/no, porque el defecto real es
// parcial -de 100 cortes, 8 con el color cambiado- y el resto sigue su camino.
//
// Append-only: cada recepcion queda con su autor y su hora. La evidencia va en
// TallerEvidencia, que ya cuelga de la misma etapa.
model OdtEtapaRecepcion {
  id                Int           @id @default(autoincrement())
  odtItemTallerId   Int           @map("odt_item_taller_id")
  cantidadRevisada  Float         @map("cantidad_revisada")
  cantidadAceptada  Float         @map("cantidad_aceptada")
  cantidadRechazada Float         @map("cantidad_rechazada")
  defecto           String?
  causa             String?
  // aceptada | reproceso | descarte
  decision          String
  usuario           String
  usuarioId         Int?          @map("usuario_id")
  ipEquipo          String?       @map("ip_equipo")
  createdAt         DateTime      @default(now()) @map("created_at")
  odtItemTaller     OdtItemTaller @relation(fields: [odtItemTallerId], references: [id], onDelete: Cascade)

  @@index([odtItemTallerId, createdAt])
  @@map("odt_etapa_recepciones")
  @@schema("taller")
}

model OdtAvance {
  id                Int           @id @default(autoincrement())
  odtItemTallerId   Int           @map("odt_item_taller_id")
  cantidadTerminada Float         @map("cantidad_terminada")
  fechaTrabajo      DateTime      @default(now()) @map("fecha_trabajo")
  observacion       String?
  usuario           String
  ipEquipo          String?       @map("ip_equipo")
  createdAt         DateTime      @default(now()) @map("created_at")
  odtItemTaller     OdtItemTaller @relation(fields: [odtItemTallerId], references: [id], onDelete: Cascade)

  @@index([odtItemTallerId, fechaTrabajo])
  @@map("odt_avances")
  @@schema("taller")
}

model TallerEvidencia {
  id              Int           @id @default(autoincrement())
  odtId           Int           @map("odt_id")
  odtItemTallerId Int           @map("odt_item_taller_id")
  archivoUrl      String        @map("archivo_url")
  nombreArchivo   String        @map("nombre_archivo")
  mimeType        String        @map("mime_type")
  usuario         String
  ipEquipo        String?       @map("ip_equipo")
  createdAt       DateTime      @default(now()) @map("created_at")
  odt             Odt           @relation(fields: [odtId], references: [id], onDelete: Cascade)
  odtItemTaller   OdtItemTaller @relation(fields: [odtItemTallerId], references: [id], onDelete: Cascade)

  @@index([odtId, createdAt])
  @@index([odtItemTallerId, createdAt])
  @@map("taller_evidencias")
  @@schema("taller")
}

model Tela {
  id           Int              @id @default(autoincrement())
  codigo       String           @unique
  tipo         String?
  nombre       String?
  color        String?
  proveedor    String?
  ubicacion    String?
  ancho        Float?
  gramaje      Float?
  precio       Float?
  stock        Float            @default(0)
  stockMin     Float            @default(0) @map("stock_min")
  activo       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  movimientos  TelaMovimiento[]
  recetaLineas RecetaMaterial[]

  @@map("telas")
  @@schema("taller")
}

model TelaMovimiento {
  id              Int            @id @default(autoincrement())
  telaId          Int            @map("tela_id")
  tipo            String
  cantidad        Float
  factura         String?
  pagoProveedorId Int?           @map("pago_proveedor_id")
  origenTipo      String?        @map("origen_tipo")
  origenId        Int?           @map("origen_id")
  cortador        String?
  ubicacion       String?
  usuario         String?
  fecha           DateTime       @default(now())
