// Cotizacion comercial creada desde CRM. Es deliberadamente independiente de
// Orden: una Orden entra a Matriz solo cuando la oportunidad es aprobada.
model CrmCotizacion {
  id                        Int                    @id @default(autoincrement())
  crmId                     Int                    @unique @map("crm_id")
  tipo                      String
  clienteSucursalId         Int?                   @map("cliente_sucursal_id")
  vendedorId                Int?                   @map("vendedor_id")
  licitacion                String?
  licitacionFecha           DateTime?              @map("licitacion_fecha")
  licitacionPlazo           String?                @map("licitacion_plazo")
  licitacionReferencia      String?                @map("licitacion_referencia")
  licitacionOC              String?                @map("licitacion_oc")
  observaciones             String?
  descuentoPct              Float                  @default(0) @map("descuento_pct")
  enviosParciales           Boolean                @default(false) @map("envios_parciales")
  montoDespacho             Float                  @default(0) @map("monto_despacho")
  fechaPlazo                DateTime?              @map("fecha_plazo")
  plazoEntregaDias          Int?                   @map("plazo_entrega_dias")
  plazoEntregaTipo          String?                @map("plazo_entrega_tipo")
  direccionDespacho         String?                @map("direccion_despacho")
  direccionDespachoExtra    String?                @map("direccion_despacho_extra")
  contactoDespacho          String?                @map("contacto_despacho")
  telefonoContactoDespacho  String?                @map("telefono_contacto_despacho")
  emailContactoDespacho     String?                @map("email_contacto_despacho")
  regionDespacho            String?                @map("region_despacho")
  comunaDespacho            String?                @map("comuna_despacho")
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")
  // Aceptacion del cliente (CU-06). Se guarda contra que version acepto: si
  // despues se edita la cotizacion, queda a la vista que lo aceptado cambio.
  aceptadaAt                DateTime?              @map("aceptada_at")
  aceptadaVersion           Int?                   @map("aceptada_version")
  aceptadaPor               String?                @map("aceptada_por")
  aceptacionMedio           String?                @map("aceptacion_medio")
  aceptacionReferencia      String?                @map("aceptacion_referencia")
  aceptacionRegistradaPorId Int?                   @map("aceptacion_registrada_por_id")
  crm                       CrmRegistro            @relation("CrmRegistroCotizacion", fields: [crmId], references: [id], onDelete: Cascade)
  items                     CrmCotizacionItem[]
  versiones                 CrmCotizacionVersion[]

  @@index([tipo])
  @@map("crm_cotizaciones")
  @@schema("ventas")
}

model CrmCotizacionItem {
  id              Int           @id @default(autoincrement())
  cotizacionId    Int           @map("cotizacion_id")
  productoId      Int           @map("producto_id")
  codigoInterno   String?       @map("codigo_interno")
  nombre          String?
  descripcion     String?
  cantidad        Int
  // null = adjudicacion no registrada (se vende lo cotizado); 0 = no adjudicada.
  cantAdjudicados Int?          @map("cant_adjudicados")
  precioUnitario  Float         @map("precio_unitario")
  cotizacion      CrmCotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
  @@index([productoId])
  @@map("crm_cotizacion_items")
  @@schema("ventas")
}

// Copia inmutable de la propuesta en un momento dado. Antes, editar una
// cotizacion borraba los items y los volvia a crear, de modo que no quedaba
// rastro de que se le habia ofrecido al cliente.
model CrmCotizacionVersion {
  id              Int           @id @default(autoincrement())
  cotizacionId    Int           @map("cotizacion_id")
  version         Int
  snapshot        Json
  total           Float         @default(0)
  motivo          String?
  creadaPorId     Int?          @map("creada_por_id")
  creadaPorNombre String?       @map("creada_por_nombre")
  createdAt       DateTime      @default(now()) @map("created_at")
  cotizacion      CrmCotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@unique([cotizacionId, version])
  @@map("crm_cotizacion_versiones")
  @@schema("ventas")
}

