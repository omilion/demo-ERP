  totalDescuentos      Int?      @map("total_descuentos")
  anticipos            Int?
  liquidoPagar         Int?      @map("liquido_pagar")
  totalHorasExtras     Int?      @map("total_horas_extras")
  cantidadTrabajadores Int?      @map("cantidad_trabajadores")
  imagen               String?
  createdAt            DateTime? @default(now()) @map("created_at")
  updatedAt            DateTime? @updatedAt @map("updated_at")

  @@index([empresa])
  @@index([anio, mes])
  @@map("libros_remuneracion")
  @@schema("rrhh")
}
