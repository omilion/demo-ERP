  horaSalidaAm  DateTime   @map("hora_salida_am") @db.Time
  horaIngresoPm DateTime   @map("hora_ingreso_pm") @db.Time
  horaSalidaPm  DateTime   @map("hora_salida_pm") @db.Time
  totalHoras    Float?     @map("total_horas")
  horasExtras   Float?     @map("horas_extras")
  createdAt     DateTime?  @default(now()) @map("created_at")
  updatedAt     DateTime?  @updatedAt @map("updated_at")
  trabajador    Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  jornada       Jornada    @relation(fields: [jornadaId], references: [id])
  tipoDia       TipoDia?   @relation(fields: [tipoDiaId], references: [id])

  @@index([trabajadorId])
  @@index([anio, mes])
  @@map("asistencias")
  @@schema("rrhh")
}

