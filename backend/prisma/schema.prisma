generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "clientes", "catalogo", "ventas", "caja", "taller", "bodega", "config", "rrhh", "ai", "facturacion"]
}

// ── AUTH ──────────────────────────────────────────────────────────────

model User {
  id                         Int              @id @default(autoincrement())
  email                      String           @unique
  passwordHash               String           @map("password_hash")
  role                       Role
  nombre                     String
  rut                        String?
  codigoVendedor             String?          @unique @map("codigo_vendedor")
  cargo                      String?
  permisoDescuentos          Boolean          @default(false) @map("permiso_descuentos")
  permisoAprobarDescuentos   Boolean          @default(false) @map("permiso_aprobar_descuentos")
  permisosExtra              Json?            @map("permisos_extra")
  tiposVentaPermitidos       Json?            @map("tipos_venta_permitidos")
  sucursalId                 Int?             @map("sucursal_id")
  activo                     Boolean          @default(true)
  createdAt                  DateTime         @default(now()) @map("created_at")
  sessions                   Session[]
  accesos                    AccesoLog[]
  comisionReglas             ComisionRegla[]
  odtResponsabilidades       OdtItemTaller[]  @relation("OdtResponsable")
  talleresQueJefatura        Taller[]         @relation("TallerJefe")
  trabajador                 Trabajador?      @relation("TrabajadorUsuario")
  reglasDescuentoCreadas     DescuentoRegla[] @relation("DescuentoReglaCreadaPor")
  reglasDescuentoModificadas DescuentoRegla[] @relation("DescuentoReglaModificadaPor")

  @@index([codigoVendedor])
  @@map("users")
  @@schema("auth")
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("auth")
}

enum Role {
  admin
  vendedor
  coordinador_comercial
  bodeguero
  cajero
  taller
  taller_operario
  rrhh
  solo_lectura

  @@schema("auth")
}

model Sucursal {
  id        Int     @id @default(autoincrement())
  nombre    String
  direccion String?
  comuna    String?
  region    String?
  telefono  String?
  activo    Boolean @default(true)

  @@map("sucursales")
  @@schema("auth")
}

model AccesoLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  usuario   String
  origen    String   @default("erp")
  estado    String
  ip        String?
  userAgent String?  @map("user_agent")
  fecha     DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([fecha])
  @@map("accesos")
  @@schema("auth")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  userEmail  String?  @map("user_email")
  userNombre String?  @map("user_nombre")
  role       String?
  method     String
  path       String
  status     Int?
  entity     String?
  entityId   String?  @map("entity_id")
  payload    Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity])
  @@index([method])
  @@index([createdAt])
  @@map("audit_log")
  @@schema("auth")
}

// ── CONFIG ────────────────────────────────────────────────────────────

model EmpresaConfig {
  id                             Int      @id @default(autoincrement())
  nombre                         String
  rut                            String
  razonSocial                    String?  @map("razon_social")
  giro                           String?
  email                          String?
  telefono                       String?
  direccion                      String?
  region                         String?
  comuna                         String?
  codigoEmpresa                  Int?     @map("codigo_empresa")
  logoUrl                        String?  @map("logo_url")
  textoPie                       String?  @map("texto_pie")
  metaMensualVentas              Float    @default(0) @map("meta_mensual_ventas")
  escaneoCodigoBarrasObligatorio Boolean  @default(false) @map("escaneo_codigo_barras_obligatorio")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  @@map("empresa")
  @@schema("config")
}

model FirmaEmail {
  id      Int     @id @default(autoincrement())
  alias   String
  email   String
  firma   String
  fotoUrl String? @map("foto_url")
  activo  Boolean @default(true)

  @@map("firmas_email")
  @@schema("config")
}

model BloqueoPagina {
  id     Int     @id @default(autoincrement())
  modulo String  @unique
  estado String
  texto  String?

  @@map("bloqueo_pagina")
  @@schema("config")
}

// ── CLIENTES ─────────────────────────────────────────────────────────

model Cliente {
  id                 Int               @id @default(autoincrement())
  rut                String            @unique
  nombre             String
  email              String?
  telefono           String?
  giro               String?
  direccion          String?
  region             String?
  comuna             String?
  ciudad             String?
  pais               String?           @default("Chile")
  tipo               String?
  razonSocial        String?           @map("razon_social")
  limiteCredito      Float?            @map("limite_credito")
  diasInactivoAlerta Int?              @map("dias_inactivo_alerta")
  segmento           String?           @default("C")
  activo             Boolean           @default(true)
  conflictivo        Boolean           @default(false) @map("conflictivo")
  conflictivoDetalle String?           @map("conflictivo_detalle")
  sucursales         ClienteSucursal[]
  oportunidadesCrm   CrmRegistro[]
  ordenes            Orden[]

  @@map("clientes")
  @@schema("clientes")
}

model ClienteSucursal {
  id          Int      @id @default(autoincrement())
  clienteId   Int      @map("cliente_id")
  nombre      String
  direccion   String?
  region      String?
  comuna      String?
  ciudad      String?
  pais        String?  @default("Chile")
  contacto    String?
  email       String?
  telefono    String?
  isPrincipal Boolean  @default(false) @map("is_principal")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordenes     Orden[]

  @@unique([clienteId, nombre])
  @@index([clienteId])
  @@map("cliente_sucursales")
  @@schema("clientes")
}

model Region {
  id     Int     @id @default(autoincrement())
  codigo Int?    @unique
  nombre String
  activo Boolean @default(true)

  @@map("regiones")
  @@schema("clientes")
}

model Comuna {
  id              Int     @id @default(autoincrement())
  codigoComuna    Int?    @unique @map("codigo_comuna")
  codigoRegion    Int?    @map("codigo_region")
  codigoProvincia Int?    @map("codigo_provincia")
  nombre          String
  activo          Boolean @default(true)

  @@index([codigoRegion])
  @@map("comunas")
  @@schema("clientes")
}

model Competencia {
  id          Int     @id @default(autoincrement())
  rut         String?
  email       String?
  nombre      String?
  razonSocial String? @map("razon_social")

  @@map("competencia")
  @@schema("clientes")
}

// ── CATALOGO ─────────────────────────────────────────────────────────

model Producto {
  id                        Int                        @id @default(autoincrement())
  codigoInterno             String                     @unique @map("codigo_interno")
  codigoBarra               String?                    @map("codigo_barra")
  nombre                    String
  descripcion               String?
  categoria                 String?
  proveedor                 String?
  bodega                    String                     @default("Inventario")
  categoriaId               Int?                       @map("categoria_id")
  subcategoriaId            Int?                       @map("subcategoria_id")
  proveedorId               Int?                       @map("proveedor_id")
  unidadMedida              String?                    @map("unidad_medida")
  idMarco                   String?                    @map("id_marco")
  precioLista               Float                      @default(0) @map("precio_lista")
  precioMarco               Float                      @default(0) @map("precio_marco")
  precioLicitacion          Float?                     @map("precio_licitacion")
  porcDesc                  Float                      @default(0) @map("porc_desc")
  stock                     Int                        @default(0)
  stockReservado            Int                        @default(0) @map("stock_reservado")
  stockDanado               Int                        @default(0) @map("stock_danado")
  stockCritico              Int                        @default(0) @map("stock_critico")
  ubicacion                 String?
  ubicacionId               Int?                       @map("ubicacion_id")
  visibleWeb                Boolean                    @default(false) @map("visible_web")
  fotoUrl                   String?                    @map("foto_url")
  fotoUrlGrande             String?                    @map("foto_url_grande")
  fotosGaleria              Json?                      @map("fotos_galeria")
  descripcionLicitacion     String?                    @map("descripcion_licitacion")
  linkCompra                String?                    @map("link_compra")
  edad                      String?
  materialidad              String?
  descripcionWeb            String?                    @map("descripcion_web")
  precioWeb                 Float?                     @map("precio_web")
  ordenWeb                  Int?                       @map("orden_web")
  destacadoWeb              Boolean                    @default(false) @map("destacado_web")
  estadoInventario          String?                    @map("estado_inventario")
  activo                    Boolean                    @default(true)
  tallerId                  Int?                       @map("taller_id")
  tiempoTeorico             Int?                       @map("tiempo_teorico")
  subcategoria              Subcategoria?              @relation(fields: [subcategoriaId], references: [id])
  ubicacionCatalogo         Ubicacion?                 @relation(fields: [ubicacionId], references: [id])
  proveedores               ProductoProveedor[]
  taller                    Taller?                    @relation("ProductoTaller", fields: [tallerId], references: [id])
  notaCreditoInternaItems   NotaCreditoInternaItem[]
  receta                    ProductoReceta?
  costeoSnapshots           CosteoSnapshot[]
  importacionItems          ImportacionItem[]
  ordenCompraProveedorItems OrdenCompraProveedorItem[]

  @@index([subcategoriaId])
  @@index([categoriaId])
  @@index([ubicacionId])
  @@index([tallerId])
  @@map("productos")
  @@schema("catalogo")
}

model ProductoProveedor {
  id              Int       @id @default(autoincrement())
  productoId      Int       @map("producto_id")
  proveedorId     Int       @map("proveedor_id")
  // Codigo con el que ESE proveedor identifica este producto en su propia
  // guia/factura (casi nunca coincide con nuestro codigoInterno). Se guarda
  // para resolver automaticamente futuras compras del mismo proveedor.
  codigoProveedor String?   @map("codigo_proveedor")
  costo           Float     @default(0)
  cantidad        Int       @default(0)
  ultimaCompra    DateTime? @map("ultima_compra")
  activo          Boolean   @default(true)
  producto        Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  proveedor       Proveedor @relation(fields: [proveedorId], references: [id])

  @@unique([productoId, proveedorId])
  @@index([productoId])
  @@index([proveedorId])
  @@index([proveedorId, codigoProveedor])
  @@map("producto_proveedores")
  @@schema("catalogo")
}

model Ubicacion {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  // Nomenclatura estructurada (5 campos ordinales, ej. For-Bodega3-05-C-02):
  // opcional para no romper ubicaciones legacy en texto libre. Cuando estan
  // presentes, `nombre` se compone a partir de ellos en vez de tipearse a mano.
  sucursal  String?
  area      String?
  estante   String?
  cuerpo    String?
  nivel     String?
  activo    Boolean    @default(true)
  productos Producto[]

  @@map("ubicaciones")
  @@schema("catalogo")
}

model Proveedor {
  id                     Int                    @id @default(autoincrement())
  nombre                 String
  rut                    String                 @unique
  razonSocial            String?                @map("razon_social")
  giro                   String?
  email                  String?
  telefono               String?
  direccion              String?
  region                 String?
  comuna                 String?
  codigoProveedor        Int?                   @map("codigo_proveedor")
  porcVentaSala          Int                    @default(0) @map("porc_venta_sala")
  porcMarco              Int                    @default(0) @map("porc_marco")
  porcLicitacion         Int                    @default(0) @map("porc_licitacion")
  pagoFactura            String?                @map("pago_factura")
  activo                 Boolean                @default(true)
  productoProveedores    ProductoProveedor[]
  importaciones          Importacion[]
  ordenesCompraProveedor OrdenCompraProveedor[]

  @@map("proveedores")
  @@schema("catalogo")
}

model PagoProveedor {
  id                      Int                       @id @default(autoincrement())
  proveedorId             Int?                      @map("proveedor_id")
  codigoProveedor         Int?                      @map("codigo_proveedor")
  sucursalId              Int?                      @map("sucursal_id")
  documento               String?
  nDoc                    String?                   @map("n_doc")
  fechaDoc                DateTime?                 @map("fecha_doc")
  fechaPago               DateTime?                 @map("fecha_pago")
  fechaVencimiento        DateTime?                 @map("fecha_vencimiento")
  estado                  String                    @default("Pendiente")
  total                   Float                     @default(0)
  usuario                 String?
  bodega                  String?
  nc                      Boolean                   @default(false)
  ncNumero                String?                   @map("nc_numero")
  ncMonto                 Float?                    @map("nc_monto")
  obs                     String?
  stockAplicadoAt         DateTime?                 @map("stock_aplicado_at")
  stockReversadoAt        DateTime?                 @map("stock_reversado_at")
  eliminado               Boolean                   @default(false)
  userMod                 String?                   @map("user_mod")
  fecham                  DateTime?
  motivoEliminacion       String?                   @map("motivo_eliminacion")
  createdAt               DateTime                  @default(now()) @map("created_at")
  movimientosBodega       MovimientoBodega[]
  detallesFactura         DetalleFacturaProveedor[]
  telaMovimientos         TelaMovimiento[]
  bodegaTallerMovimientos BodegaTallerMovimiento[]

  @@index([proveedorId])
  @@index([codigoProveedor])
  @@index([nDoc])
  @@index([eliminado])
  @@map("pagos_proveedores")
  @@schema("catalogo")
}

model PrecioHistorial {
  id             Int      @id @default(autoincrement())
  productoId     Int      @map("producto_id")
  precioAnterior Float    @map("precio_anterior")
  precioNuevo    Float    @map("precio_nuevo")
  pct            Float
  usuarioNombre  String   @map("usuario_nombre")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("precio_historial")
  @@schema("catalogo")
}

model Categoria {
  id            Int            @id @default(autoincrement())
  nombre        String
  porcDesc      Float          @default(0) @map("porc_desc")
  mostrar       Boolean        @default(true)
  activo        Boolean        @default(true)
  subcategorias Subcategoria[]

  @@map("categorias")
  @@schema("catalogo")
}

model Subcategoria {
  id          Int        @id @default(autoincrement())
  nombre      String
  categoriaId Int        @map("categoria_id")
  activo      Boolean    @default(true)
  categoria   Categoria  @relation(fields: [categoriaId], references: [id])
  productos   Producto[]

  @@index([categoriaId])
  @@map("subcategorias")
  @@schema("catalogo")
}

model CargoTransporte {
  id     Int     @id @default(autoincrement())
  nombre String
  valor  Float
  activo Boolean @default(true)

  @@map("cargo_transporte")
  @@schema("catalogo")
}

model DetalleFacturaProveedor {
  id             Int           @id @default(autoincrement())
  pagoId         Int           @map("pago_id")
  codigoInterno  String        @map("codigo_interno")
  destino        String        @default("producto")
  cantidad       Float
  precio         Float
  nombre         String?
  unidadMedida   String?       @map("unidad_medida")
  categoriaId    Int?          @map("categoria_id")
  subcategoriaId Int?          @map("subcategoria_id")
  pago           PagoProveedor @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId])
  @@map("detalle_facturas_proveedor")
  @@schema("catalogo")
}

model RelacionProducto {
  id            Int      @id @default(autoincrement())
  productoId    Int      @map("producto_id")
  relacionadoId Int      @map("relacionado_id")
  tipo          String   @default("relacionado")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([productoId, relacionadoId])
  @@index([productoId])
  @@map("relacion_productos")
  @@schema("catalogo")
}

// ── VENTAS ───────────────────────────────────────────────────────────

model Orden {
  id                       Int                         @id @default(autoincrement())
  nInterno                 Int?                        @unique @map("n_interno")
  tipo                     String
  estado                   String                      @default("Activa")
  estadoPago               String                      @default("No pagada") @map("estado_pago")
  estadoEntrega            String                      @default("Pendiente entrega") @map("estado_entrega")
  fechaEstadoEntrega       DateTime?                   @map("fecha_estado_entrega")
  estadoFlujoFormal        String                      @default("CREADA") @map("estado_flujo_formal")
  fechaEstadoFlujo         DateTime?                   @map("fecha_estado_flujo")
  clienteId                Int?                        @map("cliente_id")
  clienteSucursalId        Int?                        @map("cliente_sucursal_id")
  rutCliente               String?                     @map("rut_cliente")
  emailCliente             String?                     @map("email_cliente")
  userId                   Int                         @map("user_id")
  sucursalId               Int?                        @map("sucursal_id")
  descuentoPct             Float                       @default(0) @map("descuento_pct")
  descuentoSolicitudId     Int?                        @unique @map("descuento_solicitud_id")
  descuentoMonto           Float?                      @map("descuento_monto")
  descuentoSnapshot        Json?                       @map("descuento_snapshot")
  abono                    Float                       @default(0)
  facturado                Float?
  guias                    Int?
  licitacion               String?
  observaciones            String?
  creadorNombre            String?                     @map("creador_nombre")
  requiereAprobacion       Boolean                     @default(false) @map("requiere_aprobacion")
  nImpresiones             Int                         @default(0) @map("n_impresiones")
  eliminada                Boolean                     @default(false)
  userMod                  String?                     @map("user_mod")
  fecham                   DateTime?
  createdAt                DateTime                    @default(now()) @map("created_at")
  enviosParciales          Boolean                     @default(false) @map("envios_parciales")
  montoDespacho            Float                       @default(0) @map("monto_despacho")
  fechaPlazo               DateTime?                   @map("fecha_plazo")
  direccionDespacho        String?                     @map("direccion_despacho")
  direccionDespachoExtra   String?                     @map("direccion_despacho_extra")
  contactoDespacho         String?                     @map("contacto_despacho")
  telefonoContactoDespacho String?                     @map("telefono_contacto_despacho")
  emailContactoDespacho    String?                     @map("email_contacto_despacho")
  plazoEntregaDias         Int?                        @map("plazo_entrega_dias")
  plazoEntregaTipo         String?                     @map("plazo_entrega_tipo")
  marketplaceCanal         String?                     @map("marketplace_canal")
  marketplaceComisionPct   Float?                      @map("marketplace_comision_pct")
  marketplaceComisionMonto Float?                      @map("marketplace_comision_monto")
  marketplaceReferencia    String?                     @map("marketplace_referencia")
  regionDespacho           String?                     @map("region_despacho")
  comunaDespacho           String?                     @map("comuna_despacho")
  ciudadDespacho           String?                     @map("ciudad_despacho")
  items                    OrdenItem[]
  cargos                   OrdenCargo[]
  despachos                Despacho[]
  guiasDespacho            GuiaDespacho[]
  movimientosBodega        MovimientoBodega[]
  movimientosCaja          MovimientoCaja[]
  packingBultos            PackingBulto[]
  packingEventos           PackingEvento[]
  despachoAjustes          DespachoAjusteHistorial[]
  historialEstadoFlujo     OrdenEstadoFlujoHistorial[]
  notasCreditoInternas     NotaCreditoInterna[]
  oportunidadesCrm         CrmRegistro[]
  // La base ya tenia el foreign key con RESTRICT: un cliente con ventas no se
  // puede borrar. Se declara igual para no alterar ese comportamiento; las bajas
  // de cliente se hacen con el flag `activo`, no borrando la fila.
  cliente                  Cliente?                    @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  clienteSucursal          ClienteSucursal?            @relation(fields: [clienteSucursalId], references: [id], onDelete: SetNull)
  descuentoSolicitud       DescuentoSolicitud?         @relation("OrdenDescuentoSolicitud", fields: [descuentoSolicitudId], references: [id], onDelete: SetNull)
  excepcionAlertas         ExcepcionAlerta[]

  @@index([nInterno])
  @@index([clienteId])
  @@index([clienteSucursalId])
  @@index([rutCliente])
  // Filtro por rango de fechas de la reporteria gerencial.
  @@index([createdAt])
  @@map("ordenes")
  @@schema("ventas")
}

// Bitácora inmutable del ciclo operativo de una venta. `estado_flujo_formal`
// es el estado actual; esta tabla conserva quién hizo cada transición y cuándo.
model OrdenEstadoFlujoHistorial {
  id             Int      @id @default(autoincrement())
  ordenId        Int      @map("orden_id")
  estadoAnterior String?  @map("estado_anterior")
  estadoNuevo    String   @map("estado_nuevo")
  motivo         String?
  usuarioId      Int?     @map("usuario_id")
  usuarioNombre  String?  @map("usuario_nombre")
  usuarioRol     String?  @map("usuario_rol")
  createdAt      DateTime @default(now()) @map("created_at")
  orden          Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId, createdAt])
  @@index([estadoNuevo])
  @@map("orden_estado_flujo_historial")
  @@schema("ventas")
}

model OrdenItem {
  id              Int             @id @default(autoincrement())
  ordenId         Int             @map("orden_id")
  productoId      Int             @map("producto_id")
  codigoInterno   String?         @map("codigo_interno")
  nombre          String?
  descripcion     String?
  cantidad        Int
  nEntregados     Int             @default(0) @map("n_entregados")
  precioUnitario  Float           @map("precio_unitario")
  precioConIva    Float?          @map("precio_con_iva")
  cargoTransporte Float           @default(0) @map("cargo_transporte")
  eliminado       Boolean         @default(false)
  userMod         String?         @map("user_mod")
  fecham          DateTime?
  orden           Orden           @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  packingEventos  PackingEvento[]

  @@index([ordenId])
  @@map("orden_items")
  @@schema("ventas")
}

model OrdenCargo {
  id      Int    @id @default(autoincrement())
  ordenId Int    @map("orden_id")
  nombre  String
  valor   Float
  orden   Orden  @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId])
  @@map("orden_cargos")
  @@schema("ventas")
}

model CobranzaHistorico {
  id           Int       @id @default(autoincrement())
  ordenId      Int?      @map("orden_id")
  ejecutiva    String?
  interno      Int?
  ndoc         Int?
  monto        Float?
  montoMenos   Float?    @map("monto_menos")
  nc           Float?
  valorFactura Float?    @map("valor_factura")
  multas       Float?
  cliente      String?
