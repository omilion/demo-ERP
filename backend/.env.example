NODE_ENV=development
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# Base local de desarrollo creada por docker-compose.yml.
DATABASE_URL=postgresql://plastimar:plastimar@localhost:55432/plastimar_dev?schema=public
# Para las pruebas, sobrescribir DATABASE_URL con:
# postgresql://plastimar:plastimar@localhost:55432/plastimar_test?schema=public

JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Gmail API OAuth2, cuenta receptora DTE. Nunca versionar valores reales.
GMAIL_RECEPTOR_CLIENT_ID=
GMAIL_RECEPTOR_CLIENT_SECRET=
GMAIL_RECEPTOR_REFRESH_TOKEN=
